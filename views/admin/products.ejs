<%- include('../includes/head.ejs') %>



    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <h1>Your Products</h1>

                <% if(prods.length> 0) { %>
                    <ul class="product-list">
                        <% for(let i=0; i < prods.length; i++) { %>
                            <li class="product-item">
                                <h2>
                                    <%= prods[i].title %>
                                </h2>
                                <p>Price: $19.99</p>
                                <p>Description: A book about <%= prods[i].title %>
                                </p>
                                <img src="https://media.istockphoto.com/id/2060984408/photo/stack-of-colorful-books-education-background-back-to-school-book-hardback-colorful-books-on.jpg?s=612x612&w=0&k=20&c=S-a-AjcVaONddGxfcfbNckme8H7ujSllz-MjgmcKrVQ="
                                    alt="<%= prods[i].title %>">
                            </li>
                            <% } %>
                    </ul>
                    <% } else { %>

                        <p>No products found!</p>
                        <% } %>
            </main>
            <%- include('../includes/end.ejs') %>